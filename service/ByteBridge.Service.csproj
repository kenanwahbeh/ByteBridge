<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows service that actually hosts the gateway.

    This is what makes the gateway survive a reboot and run with nobody
    logged in, which the WPF app never could: it died with its window.
    On Windows Server, where there may be no desktop session at all, this
    is the only part that runs.

    Plain net10.0 so the same program also runs on Linux, under systemd.
    The Windows-only parts (service control manager, event log, URL
    reservation, ACLs) are guarded at run time. The gateway itself lives
    in ByteBridge.Core and stays portable.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ByteBridge.Service</RootNamespace>
    <AssemblyName>ByteBridge.Service</AssemblyName>
    <Product>ByteBridge</Product>
    <Company>ByteBridge</Company>
    <Description>ByteBridge gateway service</Description>
    <Copyright>Copyright © ByteBridge</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
  </ItemGroup>

  <!--
    A Linux publish is the install bundle: the unit and the install
    script travel with the executable, so scripts/linux/install.sh finds
    everything next to itself. Windows publishes are left alone.
  -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <None Include="../scripts/linux/bytebridge.unit;../scripts/linux/install.sh"
          Link="%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../core/ByteBridge.Core.csproj" />
  </ItemGroup>

</Project>
