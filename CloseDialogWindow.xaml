<Window x:Class="ByteBridge.CloseDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByteBridge"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">

    <!--
        Two equal-width choices side by side, the safe one (keep the
        gateway running in the tray) as the default. Closing with the
        title-bar button or Esc cancels, so there is no separate Cancel
        or Settings button to pick between.
    -->
    <StackPanel Margin="24">

        <TextBlock x:Name="MessageTextBlock"
                   Text="What would you like to do?"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="TrayButton"
                    Grid.Column="0"
                    Content="Minimize to Tray"
                    Padding="16,10"
                    FontSize="14"
                    IsDefault="True"
                    Click="TrayButton_Click"/>

            <Button x:Name="ExitButton"
                    Grid.Column="2"
                    Content="Exit"
                    Padding="16,10"
                    FontSize="14"
                    Click="ExitButton_Click"/>
        </Grid>

        <CheckBox x:Name="DontAskCheckBox"
                  Content="Don't ask again"
                  Margin="0,16,0,0"/>

    </StackPanel>

</Window>
