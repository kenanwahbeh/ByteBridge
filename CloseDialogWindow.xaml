<Window x:Class="ByteBridge.CloseDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByteBridge"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="White">

    <!--
        One column of full-width buttons rather than several crammed
        into a fixed-width row: it can't overflow or clip regardless
        of how long the localized label is, in either flow direction.
    -->
    <StackPanel Margin="24">

        <TextBlock x:Name="MessageTextBlock"
                   Text="What would you like to do?"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <Button x:Name="TrayButton"
                Content="Minimize to Tray"
                Padding="16,10"
                Margin="0,0,0,8"
                Click="TrayButton_Click"
                FontSize="14"/>

        <Button x:Name="SettingsButton"
                Content="Settings"
                Padding="16,10"
                Margin="0,0,0,8"
                Click="SettingsButton_Click"
                FontSize="14"/>

        <Button x:Name="ExitButton"
                Content="Exit"
                Padding="16,10"
                Margin="0,0,0,8"
                Click="ExitButton_Click"
                FontSize="14"
                Background="#E74C3C"
                Foreground="White"/>

        <Button x:Name="CancelButton"
                Content="Cancel"
                Padding="16,10"
                Margin="0,8,0,0"
                Click="CancelButton_Click"
                FontSize="14"/>

    </StackPanel>

</Window>
