<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the system tray icon: WPF has no NotifyIcon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!--
    UseWindowsForms adds implicit global usings for System.Windows.Forms
    and System.Drawing, which collide with WPF's own Application,
    MessageBox, Brushes and Color the moment both are in scope
    unqualified. The tray icon code refers to its handful of
    WinForms/GDI+ types (NotifyIcon, ContextMenuStrip, Icon, ...) by
    full name instead, so neither global using buys anything here and
    both only break the rest of the app.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!--
    Shipping metadata.

    Version is overridden by the release workflow from the git tag
    (-p:Version=...), so the value here is only what a local build
    stamps. Company and Product show up in the installed program's
    Add/Remove Programs entry and in the file properties.

  -->
  <PropertyGroup>
    <AssemblyName>ByteBridge</AssemblyName>
    <RootNamespace>ByteBridge</RootNamespace>
    <Product>ByteBridge</Product>
    <Company>ByteBridge</Company>
    <Description>HTTP gateway for your databases</Description>
    <Copyright>Copyright © ByteBridge</Copyright>
    <Version>1.0.0</Version>
    <ApplicationIcon>../installer/ByteBridge.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../core/ByteBridge.Core.csproj" />
  </ItemGroup>

  <!--
    The maker's logo: the About window shows it, and the main window uses
    it as its own icon so the taskbar button always has one.
  -->
  <ItemGroup>
    <Resource Include="Assets\bytebalance-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!--
    The project lives in app/, so the SDK's default glob only ever sees
    this app's own sources. No exclusion list: a new project elsewhere
    in the repo cannot leak into this build.
  -->
</Project>
