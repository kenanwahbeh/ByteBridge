<Window x:Class="ByteBridge.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Connect to ByteBalance"
        Width="600"
        SizeToContent="Height"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <StackPanel Margin="24">

            <TextBlock x:Name="StateTextBlock"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="IntroTextBlock"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Opacity="0.8"/>

            <StackPanel Margin="0,20,0,0">
                <TextBlock x:Name="EmailTextBlock"
                           FontSize="15"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="EmailTextBox"
                         Margin="0,8,0,0"
                         Padding="10"
                         ToolTip="you@example.com"/>
            </StackPanel>

            <TextBox x:Name="LogTextBox"
                     Margin="0,16,0,0"
                     Height="150"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">

                <Button x:Name="CloseButton"
                        Padding="18,9"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="CloseButton_Click"/>

                <Button x:Name="DisconnectButton"
                        Padding="18,9"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Click="DisconnectButton_Click"/>

                <ui:Button x:Name="ActionButton"
                           Padding="24,9"
                           Appearance="Primary"
                           Click="ActionButton_Click"/>

            </StackPanel>

        </StackPanel>
    </Grid>

</Window>
