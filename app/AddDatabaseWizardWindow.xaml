<Window x:Class="ByteBridge.AddDatabaseWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add Database"
        Width="620"
        Height="640"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Step indicator -->
        <StackPanel x:Name="StepIndicatorPanel"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="24,16,24,0">

            <Border x:Name="Step1Pill" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0">
                <TextBlock x:Name="Step1Number" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <TextBlock x:Name="Step1Label" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="13"/>

            <Border x:Name="Step2Pill" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0">
                <TextBlock x:Name="Step2Number" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <TextBlock x:Name="Step2Label" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="13"/>

            <Border x:Name="Step3Pill" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0">
                <TextBlock x:Name="Step3Number" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <TextBlock x:Name="Step3Label" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="13"/>

            <Border x:Name="Step4Pill" Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0">
                <TextBlock x:Name="Step4Number" Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <TextBlock x:Name="Step4Label" VerticalAlignment="Center" FontSize="13"/>

        </StackPanel>

        <ScrollViewer x:Name="FormScrollViewer"
                      Grid.Row="1"
                      Margin="24,20,24,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid>

                <!-- Step 1: Connection name -->
                <StackPanel x:Name="Step1Content">
                    <TextBlock x:Name="Step1Title" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="Step1Hint" Margin="0,6,0,20" FontSize="13" Foreground="Gray" TextWrapping="Wrap"/>

                    <TextBlock x:Name="ConnectionNameLabel" FontSize="15" FontWeight="SemiBold"/>
                    <TextBox x:Name="NameTextBox" Margin="0,8,0,0" Padding="10" GotKeyboardFocus="TextBox_GotKeyboardFocus"/>

                    <TextBlock x:Name="EngineLabel" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0"/>
                    <ComboBox x:Name="TypeComboBox" Margin="0,8,0,0" Padding="10">
                        <ComboBoxItem Content="Firebird"/>
                        <ComboBoxItem Content="PostgreSQL"/>
                    </ComboBox>
                </StackPanel>

                <!-- Step 2: Server details -->
                <StackPanel x:Name="Step2Content" Visibility="Collapsed">
                    <TextBlock x:Name="Step2Title" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                    <TextBlock x:Name="ServerLabel" FontSize="15" FontWeight="SemiBold"/>
                    <TextBox x:Name="ServerTextBox" Text="localhost" Margin="0,8,0,18" Padding="10" GotKeyboardFocus="TextBox_GotKeyboardFocus"/>

                    <TextBlock x:Name="PortLabel" FontSize="15" FontWeight="SemiBold"/>
                    <TextBox x:Name="PortTextBox" Text="3050" Margin="0,8,0,18" Padding="10" GotKeyboardFocus="TextBox_GotKeyboardFocus"/>

                    <TextBlock x:Name="DatabaseLabel" FontSize="15" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,8,0,8" LastChildFill="True">
                        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="16,0" Click="Browse_Click"/>
                        <TextBox x:Name="DatabaseTextBox" Padding="10" GotKeyboardFocus="TextBox_GotKeyboardFocus"/>
                    </DockPanel>
                    <TextBlock x:Name="DatabaseHint" FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Step 3: Credentials -->
                <StackPanel x:Name="Step3Content" Visibility="Collapsed">
                    <TextBlock x:Name="Step3Title" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                    <TextBlock x:Name="UsernameLabel" FontSize="15" FontWeight="SemiBold"/>
                    <TextBox x:Name="UsernameTextBox" Text="SYSDBA" Margin="0,8,0,18" Padding="10" GotKeyboardFocus="TextBox_GotKeyboardFocus"/>

                    <TextBlock x:Name="PasswordLabel" FontSize="15" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,8,0,8" LastChildFill="True">
                        <ToggleButton x:Name="RevealPasswordButton" DockPanel.Dock="Right" Margin="8,0,0,0" Width="42"
                                      FontFamily="Segoe MDL2 Assets" FontSize="16" Content="&#xE7B3;"
                                      Checked="RevealPassword_Changed" Unchecked="RevealPassword_Changed"/>
                        <Grid>
                            <PasswordBox x:Name="PasswordBox" Padding="10" PasswordChanged="PasswordBox_PasswordChanged"/>
                            <TextBox x:Name="PasswordRevealBox" Padding="10" Visibility="Collapsed"
                                     TextChanged="PasswordRevealBox_TextChanged"/>
                        </Grid>
                    </DockPanel>
                    <TextBlock x:Name="PasswordHint" FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Step 4: Test & finish -->
                <StackPanel x:Name="Step4Content" Visibility="Collapsed">
                    <TextBlock x:Name="Step4Title" FontSize="22" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="Step4Hint" FontSize="13" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <ui:Button x:Name="TestButton" Padding="18,9" HorizontalAlignment="Left" Click="TestButton_Click"/>

                    <Border x:Name="TestResultBorder" Padding="12" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TestResultTextBlock" TextWrapping="Wrap" FontSize="14"/>
                    </Border>
                </StackPanel>

            </Grid>

        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,16,24,20">

            <Button x:Name="CancelButton" Padding="18,9" Margin="0,0,10,0" IsCancel="True" Click="CancelButton_Click"/>
            <Button x:Name="BackButton" Padding="18,9" Margin="0,0,10,0" Click="BackButton_Click"/>
            <ui:Button x:Name="NextButton" Padding="24,9" Appearance="Primary" IsDefault="True" Click="NextButton_Click"/>
            <ui:Button x:Name="SaveButton" Padding="24,9" Appearance="Primary" IsDefault="True" Visibility="Collapsed" Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
